# Generated by the design canvas tool — 2MB+ of editor payload, rebuilt on
# every re-seed from the .dc.html working files next to it.
design/oshideck-card-deck-ui.html

# Exported backups
oshideck-*.json

# Pasted screenshots — macOS names these by locale, so match those too
image*.png
截圖*.png
Screenshot*.png
スクリーンショット*.png

# The maintainer's own requirements notes — a working file, not a project artefact
note

# API keys. The example beside it is what gets committed.
.env
.env.*
!.env.example

# Local filesystem metadata and visual references used during development.
.DS_Store
/nijipuka.jpg
/nijipuka2.webp

# Local linked worktrees include machine-specific paths and working data.
/.claude/worktrees/

# Chat downloaded for mining — megabytes per stream, and re-fetchable
chat/
chat-*/

# What came out of mining it. A working note: re-made by one command, and
# what survives curation goes into the per-channel files under presets/.
tools/candidates/

# The saved YouTube subscriptions page — 7MB of someone's signed-in session —
# and what comes out of it. The list says who somebody follows, in the order
# they arranged them, which is theirs and not the project's. It is an input to
# mining, and mining has already been done: tools/subscriptions.mjs makes it
# again from a saved page whenever it is needed.
channels
tools/subscriptions.json
/YT_subscribe*.csv

# Local colour research inputs and review exports, removed after import.
/oshideck-channel-colours-*.csv
/oshideck-channel-colours-*-review.html

# Browserless integration-test dependencies
node_modules/

# Release ZIPs and their file/hash reports, rebuilt from the runtime allowlist.
/dist/
