{
  "manifest_version": 3,
  "name": "OshiDeck",
  "version": "0.1.3",
  "description": "YouTube Live Chat用のコメント・メンバー絵文字プリセットを保存して、すぐに呼び出せるChrome拡張機能",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
