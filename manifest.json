{
  "manifest_version": 3,
  "name": "OshiDeck",
  "version": "0.18.0",
  "description": "YouTube Live Chatのコメント・メン限スタンプを札にして、チャット横から一発で打てるChrome拡張機能",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/layout.js",
        "src/store.js",
        "src/tokens.js",
        "src/journal.js",
        "src/trending.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
