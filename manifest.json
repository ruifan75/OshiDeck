{
  "manifest_version": 3,
  "name": "OshiDeck",
  "version": "0.24.1",
  "description": "YouTube Live Chatのコメント・メン限スタンプを札にして、チャット横から一発で打てるChrome拡張機能",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/layout.js",
        "src/store.js",
        "src/tokens.js",
        "src/journal.js",
        "src/presets.js",
        "src/trending.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "OshiDeck — 設定と編成",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html"
}
