#!/bin/sh
# Keeps a name and an address out of the history.
#
# Nothing to ban is written down here. A hook in a public repository that
# spells out the string it is protecting has published it, which is the
# mistake this exists to prevent — and so has a hook that prints the string
# back at you when it refuses. See private.sh for what it asks the machine.
#
# Installed by `git config core.hooksPath tools/hooks`, which is also what
# tools/check-hooks.sh checks. `--no-verify` passes anything, but the history
# is the part you cannot take back.
set -e

. "$(dirname "$0")/private.sh"

msg=$1

say() { echo "     $1"; }

# The message read as a patch of one file, so that one scanner answers for
# both hooks: what is in the message is what is being added, and the file it
# is "in" is the message itself.
found=$({ printf -- '--- a/x\n+++ b/x\n'; sed 's/^/+/' "$msg"; } | scan | cut -f2 | sort -u)

if [ -n "$found" ]; then
  echo "FAIL このコミットメッセージは公開に向きません:"
  echo
  printf '%s\n' "$found" | sed 's|^|     |'
  echo
  say "公開リポジトリです。GitHub のアカウント名以外の呼び方は要りません。"
  say "どれのことかはここには書きません。書けば同じものを配ることになります。"
  say "どうしても必要なら --no-verify。ただし履歴は書き換えないと消せません。"
  exit 1
fi

# The identity the commit will carry. pre-commit says the same thing earlier,
# but a commit can reach here without it — a merge runs one hook and not the
# other.
if ident_is_private; then
  echo "FAIL このコミットが名乗る author / committer が公開に向きません。"
  say "git config user.email を GitHub の noreply アドレスにしてください。"
  exit 1
fi
