#!/bin/sh
# Keeps a name and an address out of the history.
#
# Nothing to ban is written down here. A hook in a public repository that
# spells out the string it is protecting has published it, which is the
# mistake this exists to prevent — so it asks the machine instead:
#
#   $HOME            the account name, which is usually the person's own
#   any address      except the forge's noreply ones
#
# Installed by `git config core.hooksPath tools/hooks`, which is also what
# tools/check-hooks.sh checks. `--no-verify` passes anything, but the history
# is the part you cannot take back.
set -e

msg=$1
bad=0

say() { echo "     $1"; }

# The account name, only when it is long enough to mean something. A home
# directory called `dev` would match half the English language.
me=$(basename "$HOME")
if [ ${#me} -ge 4 ] && grep -qi "$me" "$msg"; then
  say "名前らしき語が入っています（$HOME の持ち主の名前）"
  bad=1
fi

if grep -q "$HOME" "$msg"; then
  say "ホームディレクトリのパスが入っています"
  bad=1
fi

# Any address that is not a forge's noreply one.
found=$(grep -oE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z][A-Za-z]+' "$msg" |
        grep -vE '@users\.noreply\.github\.com$|^noreply@anthropic\.com$' || true)
if [ -n "$found" ]; then
  say "個人アドレスらしきものが入っています: $found"
  bad=1
fi

if [ "$bad" = 1 ]; then
  echo "FAIL このコミットメッセージは公開に向きません:"
  echo
  say "公開リポジトリです。GitHub のアカウント名以外の呼び方は要りません。"
  say "どうしても必要なら --no-verify。ただし履歴は書き換えないと消せません。"
  exit 1
fi
