#!/bin/sh
# The same rule for what goes into the files, not only the message.
#
# Nothing to ban is written down here either; see commit-msg for why.
#
# tools/channels.json is exempt. It is Holodex's own list of 3765 VTuber
# channels and somebody's stage name will collide with somebody's account
# name sooner or later — it did.
set -e

bad=0
me=$(basename "$HOME")

for file in $(git diff --cached --name-only --diff-filter=ACM); do
  case "$file" in
    tools/channels.json|tools/hooks/*) continue ;;
  esac

  # The status of a pipeline is its last command's, so asking `grep | sed`
  # whether it matched answers for sed — which succeeds on no input.
  hits=""
  if [ ${#me} -ge 4 ]; then
    hits=$(git show ":$file" 2>/dev/null | grep -ni "$me" || true)
  fi
  home=$(git show ":$file" 2>/dev/null | grep -n "$HOME" || true)
  mail=$(git show ":$file" 2>/dev/null |
         grep -nE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z][A-Za-z]+' |
         grep -vE '@users\.noreply\.github\.com|noreply@anthropic\.com' || true)

  for found in "$hits" "$home" "$mail"; do
    if [ -n "$found" ]; then
      echo "$found" | sed "s|^|     $file:|"
      bad=1
    fi
  done
done

if [ "$bad" = 1 ]; then
  echo "FAIL ステージされた内容は公開に向きません（上記）。"
  echo "     --no-verify で通せますが、履歴からは消えません。"
  exit 1
fi
