#!/bin/sh
# The same rule for what goes into the files, not only the message.
#
# Nothing to ban is written down here either; see commit-msg for why.
#
# tools/channels.json is exempt. It is Holodex's own list of 3765 VTuber
# channels and somebody's stage name will collide with somebody's account
# name sooner or later — it did.
#
# tools/check-hooks.sh is half exempt, and only in one direction: its job is
# to hold made-up versions of everything here refuses, so addresses in the
# domains reserved for documentation are allowed *there*. A real-looking one
# is refused in that file like anywhere else. An outright exemption would have
# been a hole with a comment over it.
set -e

. "$(dirname "$0")/private.sh"

# Read by name, not cut out of the diff; see below.
SKIP=tools/channels.json

# What git is asked for matters as much as what is done with it:
#
#   --text          a file git calls binary has no +++ line at all without it,
#                   and the name is a place something private sits
#   --no-textconv   a .gitattributes textconv driver shows git's idea of the
#                   file instead of the bytes being committed
#   --src/dst-prefix  diff.noprefix is somebody's ordinary setting, and it
#                   takes `b/` off the front — two characters off every path,
#                   which is a different path
#   core.quotePath=false  so a non-ASCII name arrives as itself rather than as
#                   octal escapes with the name hidden inside them
#
# tools/channels.json is left to the scanner to skip by name rather than
# excluded here: a pathspec covers everything under a path as well as the path
# itself, and a directory or a symlink could be put there.
patch=$(mktemp)
trap 'rm -f "$patch"' EXIT

if ! git -c core.quotePath=false diff --cached -p --text --no-textconv --no-ext-diff \
       --no-color --src-prefix=a/ --dst-prefix=b/ --diff-filter=ACMRTC > "$patch"; then
  # Fail closed. The pipeline used to end in the scanner, whose silence is
  # indistinguishable from a clean tree, so a git that could not answer read
  # as nothing to answer for.
  echo "FAIL ステージされた内容を読み出せませんでした（git diff が失敗）。"
  echo "     何が入るのか分からないまま通すわけにはいきません。"
  exit 1
fi

found=$(scan tools/check-hooks.sh < "$patch")

if [ -n "$found" ]; then
  echo "FAIL ステージされた内容は公開に向きません:"
  printf '%s\n' "$found" | sed 's|^|     |'
  echo "     中身はここには出しません。出せば同じものを配ることになります。"
  echo "     --no-verify で通せますが、履歴からは消えません。"
  exit 1
fi

# The commit's own identity, which no file shows.
if ident_is_private; then
  echo "FAIL このコミットが名乗る author / committer が公開に向きません。"
  echo "     git config user.email を GitHub の noreply アドレスにしてください。"
  echo "     ここまで作った commit も --amend で名乗り直す必要があります。"
  exit 1
fi

# The version has to move with the thing it names.
#
# It stopped: fourteen commits — everything the review turned up, the preset
# split, 290 presets — all went out as 0.39.0, because bumping it was a habit
# and habits lapse quietly. Chrome is the one that notices: an extension whose
# files changed under the same version is an extension nobody is offered an
# update to.
#
# Only what is actually shipped counts. Hooks, tests and the mining scripts
# are not in the package and have no version to move.
#
# HEAD, with no exception made for `--amend`. There was one: it read the
# parent process's command line, which meant a commit whose *message*
# mentioned --amend was taken for an amend and waved through — an exception
# anybody could ask for by typing it. Git tells a hook nothing that separates
# the two (only GIT_AUTHOR_DATE differs, and only by being reused, which an
# ordinary commit in the same second reproduces). So amending a release means
# moving the version again, which is honest: it is a different commit, and
# what it publishes is different.
version() { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }

# Both ends of a rename. --name-only names where a file landed, so moving a
# shipped file out of the package read as nothing shipped having changed:
# the file left, the version stayed.
#
# --name-status -z gives status, source and destination as three NUL records,
# and the grouping is what has to survive: cut the stream into lines first and
# a single path containing a newline shifts every record after it by one, so
# the source of the *next* rename is read as a status and never looked at.
# xargs counts NULs and cannot be shifted by anything inside a path.
shipped=$(
  { git diff --cached --name-only -z --diff-filter=ACMRTD |
      xargs -0 -n1 sh -c 'printf "%s\n" "$1" | head -1' _
    git diff --cached --name-status -z --diff-filter=RC |
      xargs -0 -n3 sh -c 'printf "%s\n" "$2" | head -1' _
  } |
  grep -E '^(manifest\.json|background\.js|content\.js|options\.js|options\.html|[^/]*\.css)$|^(src|presets|icons)/' || true)

if [ -n "$shipped" ]; then
  was=$(git show HEAD:manifest.json 2>/dev/null | version || true)
  now=$(git show :manifest.json 2>/dev/null | version || true)
  if [ -n "$was" ] && [ "$was" = "$now" ]; then
    echo "FAIL 配布されるファイルが変わったのに manifest.json の version は $was のままです。"
    echo "     直した挙動なら patch、見える変化なら minor を上げてください。"
    echo "     リリースを --amend で直す場合もこれは同じです（もう一段上げるか --no-verify）。"
    echo "$shipped" | sed 's|^|     |'
    exit 1
  fi
fi
